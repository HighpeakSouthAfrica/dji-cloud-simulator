# Host broker (localhost inside a container refers to the container itself).
MQTT_BROKER=mqtt://host.docker.internal:1883
# Remote TLS broker example:
# MQTT_BROKER=mqtts://broker.example.com:8883

# Leave empty for anonymous access. Use a broker account with the required ACLs.
MQTT_USER=
MQTT_PASSWORD=

GATEWAY_SN=DOCK-SN-001
DEVICE_SN=AIRCRAFT-SN-001
# patrol (continuous), mission, hms-alarm, or offline
SCENARIO=patrol

# Set to /app/config.json to use the example-config.json bind mount.
SIM_CONFIG=
